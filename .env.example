# apps/backend/.env  (en producción: variables del servicio, ver DEPLOY.md)
DATABASE_URL="postgresql://…@…pooler.supabase.com:6543/postgres?pgbouncer=true"
# Pooler de SESIÓN (puerto 5432 del mismo host pooler): IPv4 y apto para migraciones.
# No usar la conexión directa db.<ref>.supabase.co: es solo IPv6 y las plataformas no la alcanzan.
DIRECT_URL="postgresql://…@…pooler.supabase.com:5432/postgres"
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="…"
# Solo en producción (obligatoria ahí): origen(es) del front, separados por coma.
# CORS_ORIGIN="https://yunta.vercel.app"
# Opcional. Huso de la foto diaria (por defecto el de Argentina).
# SNAPSHOT_TIME_ZONE="America/Argentina/Buenos_Aires"

# apps/frontend/.env  (en producción: variables del proyecto en Vercel)
VITE_API_URL="http://localhost:3000"
VITE_SUPABASE_URL="https://xxxx.supabase.co"
VITE_SUPABASE_ANON_KEY="…"
